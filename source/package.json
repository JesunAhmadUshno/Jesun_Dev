{
  "name": "jesunahmadushno-com",
  "version": "2.0.0",
  "private": true,
  "description": "The site of Jesun Ahmad Ushno. All rights reserved.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "images": "python3 scripts/images.py private-originals",
    "fresh": "node scripts/github-stats.mjs",
    "build": "node scripts/build.mjs",
    "screens": "node scripts/screens.mjs",
    "lint": "node scripts/lint.mjs",
    "score": "node scripts/scorecard.mjs",
    "check": "npm run build && npm run lint && npm test && npm run score",
    "serve": "python3 -m http.server 8080 --directory dist",
    "sync": "node scripts/sync-github.mjs",
    "test": "node --test --test-reporter=tap tests/*.test.mjs > build-log/test.tap; node scripts/test-summary.mjs",
    "pretest": "node -e \"require('fs').existsSync('dist/index/passages.json')||process.exit(1)\" || npm run build",
    "publish": "npm run build && npm run lint && npm test && node scripts/publish.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "marked": "14.1.3",
    "sharp": "0.35.5",
    "puppeteer": "23.6.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
